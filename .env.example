# Copy to .env for Docker Compose; never commit .env.
# Replace this example value with your own local database password.
WRITING_V2_DB_PASSWORD=replace-with-your-local-password
WRITING_V2_DB_USER=writing_app
WRITING_V2_DB_NAME=writing_agent
WRITING_V2_DB_PORT=5433

# Java reads process environment variables, not this file automatically.
# Set DASHSCOPE_API_KEY in your terminal or IDEA Run Configuration.
